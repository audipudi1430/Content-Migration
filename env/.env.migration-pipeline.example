# Copy to env/.env.<yourstack> or merge into an existing env file.
# WordPress + Contentstack base vars are still required (see README).

# --- Source workbook (tabs = URL lists + one media tab) ---
# Columns: `url` (WordPress) + optional `new url` / `new_url` (target Contentstack path).
# Extract stores `new_url` on the tracking sheet; migrate uses it for entry `url` and seo `page_url`.
# SEO page_url shape for stories, categories, authors (shared default):
# MIGRATION_SEO_PAGE_URL_SHAPE=canonical_url_list
# Writes: seo.page_url.canonical + seo.page_url.url_list[0].url (see Broadcom stack)
MIGRATION_SOURCE_WORKBOOK=migration-source.xlsx
MIGRATION_MEDIA_TAB_NAME=media
# Media tab always uses /wp-json/wp/v2/media — do NOT list it in MIGRATION_SHEET_WP_REST_PATHS (ignored for media).
# REST collection for tabs that do not have a per-tab override (see MIGRATION_SHEET_WP_REST_PATHS).
MIGRATION_WP_REST_PATH=/wp-json/wp/v2/posts
# Optional: per Excel tab name, WordPress REST base and Contentstack type (semicolon-separated sheet=value pairs).
# Tab names must match workbook sheet names exactly (e.g. categories, blog_author).
# MIGRATION_SHEET_WP_REST_PATHS=categories=/wp-json/wp/v2/story_category;blog_author=/wp-json/wp/v2/story_author
# MIGRATION_SHEET_CONTENT_TYPE_UID=categories=story_category;blog_author=blog_author
# Which tab from the workbook defines the content queue for migrate-content.
MIGRATION_START_SHEET=posts
MIGRATION_CONTENT_TYPE_UID=
MIGRATION_RUN_ID=stack-a
MIGRATION_ENV_LABEL=stack-a
# Logical microsite label on every tracking row (Excel + MongoDB); stamped on extract and migrate.
# MIGRATION_MICROSITE=news

# --- Extract (one tab at a time recommended): --tab=<Excel tab name> on CLI or MIGRATION_EXTRACT_TAB ---
# MIGRATION_EXTRACT_TAB=blog_author
# Parallel WordPress REST calls during enrich (default 6, max 32).
# MIGRATION_EXTRACT_CONCURRENCY=8
# Also write one tracking sheet per source tab (same workbook, tab name = sheet name).
# MIGRATION_TRACKING_PER_TAB_SHEETS=1
# Set to 1 to skip HTTP calls during extract (IDs only from URL heuristics / Excel columns).
# MIGRATION_EXTRACT_SKIP_WP_ENRICH=0
# MIGRATION_WP_EXTRACT_JSON_MAX_BYTES=80000

# --- Tracking workbook (generated/updated by pipeline) ---
MIGRATION_TRACKING_WORKBOOK=migration-tracking.xlsx
MIGRATION_TRACKING_SHEET=migration_tracking

# --- Optional featured image (asset reference field UID on the Contentstack content type) ---
CS_FEATURED_IMAGE_FIELD_UID=

# --- Optional: custom entry links in tracking / Mongo (default = Contentstack web app edit URL) ---
# CONTENTSTACK_ENTRY_TARGET_URL_TEMPLATE=https://app.contentstack.com/#!/stack/{stack_api_key}/content-type/{content_type_uid}/{locale}/entry/{entry_uid}/edit?branch={branch}
# CONTENTSTACK_BRANCH=main
# CONTENTSTACK_ASSET_TARGET_URL_TEMPLATE=https://{api_host}/v3/assets/{asset_uid}

# --- MongoDB (optional; omit MONGODB_URI to skip) ---
MONGODB_URI=
MONGODB_DB_NAME=
MONGODB_COLLECTION=migration_tracking

# --- Publish (Contentstack environment names in the stack) ---
CONTENTSTACK_PUBLISH_ENVIRONMENTS=production
CONTENTSTACK_PUBLISH_LOCALES=en-us
# PUBLISH_MODE=bulk-status
# PUBLISH_FILTER_MIGRATION_STATUS=Pass
# PUBLISH_FILTER_PUBLISH_STATUS=Unpublished

# --- SEO page owner (articles, categories, authors) ---
# Sets seo.page_owner on every migrated entry when non-empty.
# PAGE_OWNER=Broadcom Newsroom

# --- Contentstack release (add Pass entries to a release) ---
# CONTENTSTACK_RELEASE_NAME=Migration Batch 2026-06
# RELEASE_TAB=stories
# Or pass --tab=stories (overrides RELEASE_TAB / MIGRATION_START_SHEET)
# CONTENTSTACK_RELEASE_CREATE=1
# CONTENTSTACK_RELEASE_ACTION=publish
# CONTENTSTACK_RELEASE_UPDATE_TO_LATEST=1
# CONTENTSTACK_RELEASE_SKIP_EXISTING=1
# RELEASE_FILTER_MIGRATION_STATUS=Pass
# CONTENTSTACK_BRANCH=main
# CLI: npm run pipeline:add-to-release -- --env=stack-a

# --- Blog author (migrate-blog-authors) ---
# Description field type in Contentstack (must match content type schema):
#   html      — Classic Rich Text Editor (HTML string) [default]
#   text      — Text / Multi-line Text (plain, tags stripped)
#   json_rte  — JSON Rich Text Editor (structured array)
# BLOG_AUTHOR_DESCRIPTION_FORMAT=html
# Author Image group: asset goes in nested "file" field (default layout=group).
# BLOG_AUTHOR_AUTHOR_IMAGE_LAYOUT=group
# BLOG_AUTHOR_AUTHOR_IMAGE_FILE_FIELD=file
# File field CMA shape: uid = "blt..." string (default), uid_array, object, object_array
# BLOG_AUTHOR_FILE_REF_SHAPE=uid
# BLOG_AUTHOR_FIELD_AUTHOR_IMAGE=author_image
# SEO & Social group UID is "seo" (nested meta_description, page_url, etc.).
# BLOG_AUTHOR_FIELD_SEO_SOCIAL_GROUP=seo
# BLOG_AUTHOR_FIELD_URL=url
# BLOG_AUTHOR_FIELD_SEO_TITLE=title
# BLOG_AUTHOR_SEO_META_IMAGE_FILE_FIELD=file
# BLOG_AUTHOR_FIELD_META_DESCRIPTION=meta_description
# page_url: default canonical_url_list → { canonical, url_list[{ url, status, redirect }] } (same as categories)
# BLOG_AUTHOR_SEO_PAGE_URL_SHAPE=canonical_url_list
# Leave BLOG_AUTHOR_FIELD_SEO_CANONICAL unset — canonical lives inside seo.page_url, not a separate seo field
# author_title uses meta.position from story_author (not name).
# Re-migrate authors already in migration-map.json: refresh WordPress data via PUT with --update.
# Without --update, existing entries Fail (create-only).
# BLOG_AUTHOR_UPDATE=1
# CLI: npm run pipeline:migrate-blog-authors -- --env=stack-a --update --mode=single --single-id=365

# --- Blog category (migrate-blog-categories) story_category → blog_category ---
# MIGRATION_START_SHEET=categories
# MIGRATION_SHEET_WP_REST_PATHS=categories=/wp-json/wp/v2/story_category
# MIGRATION_SHEET_CONTENT_TYPE_UID=categories=blog_category
# CS_CONTENT_TYPE_BLOG_CATEGORY=blog_category
# URL: /{language}/category/{slug} — BLOG_CATEGORY_URL_LANGUAGE=en (or derived from CONTENTSTACK_LOCALE)
# BLOG_CATEGORY_URL_TEMPLATE=/{language}/category/{slug}
# BLOG_CATEGORY_FIELD_SEO_SOCIAL_GROUP=seo
# Global field inner UIDs: title, page_url, meta_description, meta_image (group) → file
# BLOG_CATEGORY_FIELD_SEO_TITLE=title
# page_url: default canonical_url_list → { canonical, url_list[{ url, status, redirect }] }
# BLOG_CATEGORY_SEO_PAGE_URL_SHAPE=canonical_url_list
# BLOG_CATEGORY_FIELD_META_DESCRIPTION=meta_description
# BLOG_CATEGORY_FIELD_META_IMAGE=meta_image
# BLOG_CATEGORY_SEO_META_IMAGE_FILE_FIELD=file
# meta_description in seo group: name (default) or wp_seo (Yoast)
# BLOG_CATEGORY_META_DESCRIPTION_SOURCE=name
# Category thumbnail (same pattern as BLOG_AUTHOR_AUTHOR_IMAGE_* / author_image group → file):
# BLOG_CATEGORY_FIELD_CATEGORY_THUMBNAIL=category_thumbnail
# BLOG_CATEGORY_THUMBNAIL_LAYOUT=group
# BLOG_CATEGORY_THUMBNAIL_FILE_FIELD=file
# BLOG_CATEGORY_THUMBNAIL_IS_GLOBAL=0
# Uses BLOG_AUTHOR_FILE_REF_SHAPE for nested file UID shape (default uid string).
# BLOG_CATEGORY_FIELD_BLOG_SUB_CATEGORIES=blog_sub_category
# Source sheet columns (stored in tracking source_columns_json): Category Name, Is Page, url, new_url, Level
# Is Page yes → show_url=yes; blank/other → show_url=no (Contentstack enum values)
# BLOG_CATEGORY_FIELD_SHOW_URL=show_url
# BLOG_CATEGORY_FIELD_CATEGORY_LEVEL=category_level
# Category Name → entry title, name fields, seo.title, seo.meta_description (REST thumbnail/og when url column set)
# BLOG_CATEGORY_FIELD_NAME=name
# BLOG_CATEGORY_LINK_SUBCATEGORIES=1
# Without --update, existing entries Fail (create-only). Use --update or BLOG_CATEGORY_UPDATE=1 to PUT.
# BLOG_CATEGORY_UPDATE=1
# CLI: npm run pipeline:extract -- --env=stack-a --tab=categories
# CLI: npm run pipeline:migrate-blog-categories -- --env=stack-a --mode=single --single-id=12

# --- Blog stories (migrate-blog-stories) story → blog ---
# Source sheet columns (stored in source_columns_json on tracking):
#   URL, new_url, Headline, Named Author, L1 (Category), Series, L2 values (Sub category), L3 values (Blog Topics)
# Named Author=None → blog_author_profile omitted; comma lists in L1/L2/Series → blog_category refs; L3 → blog_topics[]
# MIGRATION_START_SHEET=stories
# MIGRATION_SHEET_WP_REST_PATHS=stories=/wp-json/wp/v2/stories;categories=/wp-json/wp/v2/story_category;blog_author=/wp-json/wp/v2/story_author
# Stories: fetch by slug (default) so content.blocks + content.rendered are present:
# GET /wp-json/wp/v2/stories?slug={wp_slug}
# Skipped when assigning banner_image / seo.meta_image / body images (default 0.3 MiB = 314572 bytes).
# Images over this limit are compressed before upload (default 307 KB = 314368 bytes).
# MIGRATION_IMAGE_MAX_BYTES=314368
# MIGRATION_SHEET_CONTENT_TYPE_UID=stories=blog;categories=blog_category;blog_author=blog_author
# CS_CONTENT_TYPE_BLOG=blog
# URL: /articles/{slug}
# BLOG_URL_TEMPLATE=/articles/{slug}
# BLOG_FIELD_CMS_ASSET_NAME=title
# BLOG_FIELD_URL=url
# BLOG_FIELD_BLOG_CATEGORY=blog_category
# BLOG_FIELD_SHOW_IN_NEWSROOM_LANDING=show_in_newsroom_landing
# BLOG_FIELD_SHOW_IN_LATEST_BLOGS=show_in_latest_blogs
# BLOG_FIELD_SERIES_LABEL=series_label
# BLOG_FIELD_BLOG_TOPICS=blog_topics
# BLOG_FIELD_HEADLINE=headline
# BLOG_FIELD_SUB_HEADER=sub_header
# BLOG_FIELD_SHORT_LINK_TEXT=short_link_text
# BLOG_FIELD_DATELINE=dateline
# WordPress `date` like 2024-11-06T01:00:00 = Pacific wall time → stored as UTC ISO on dateline.
# Example (PST, UTC-8): WP 2024-11-06T01:00:00 → CS 2024-11-06T09:00:00.000Z
# Frontend converts UTC→Pacific and still shows 2024-11-06 (not previous day).
# BLOG_DATELINE_SOURCE_TIMEZONE=America/Los_Angeles
# Optional only; default 0. Do not use fixed +7/+8 — PST/PDT differs by season.
# BLOG_DATELINE_OFFSET_HOURS=0
# Re-fix dateline only on already-migrated stories:
# CLI: npm run pipeline:update-story-datelines -- --env=stack-a --mode=single --single-id=123
# CLI: npm run pipeline:update-story-datelines -- --env=stack-a --mode=all --limit=100
# Workbook mode (only url + new_url): find CS entry by new_url, fetch WP date from url
# UPDATE_STORY_DATELINE_WORKBOOK=story-dateline-updates.xlsx
# Columns: url (WordPress), new_url (Contentstack path)
# Writes tracking workbook: *-tracking.xlsx (url, new_url, contentstack_entry_uid, update_status Pass/Fail)
# CLI: npm run pipeline:update-story-datelines -- --env=stack-a --workbook=story-dateline-updates.xlsx --content-type=blog
# Tracking mode --mode=all processes ALL migrated rows (use --limit=N to cap)

# --- B-connected story updates (update-bconnected-stories) ---
# Excel (default next to MIGRATION_SOURCE_WORKBOOK): b-connected.xlsx tab "final"
# Columns: url, new_url, L1, L2, L3, Series; optional banner_image (asset uid)
# Finds entry by url → updates url + seo.page_url.canonical + url_list,
# copies banner_image → article_image, appends L1/L2/Series to blog_category and L3 to blog_topics.
# BCONNECTED_WORKBOOK=b-connected.xlsx
# BCONNECTED_TAB=final
# BCONNECTED_CONTENT_TYPE=blog
# BCONNECTED_LIMIT=20
# BCONNECTED_CONCURRENCY=4
# CONTENTSTACK_429_RETRIES=8
# CLI: npm run pipeline:update-bconnected-stories -- --env=stack-a --workbook=b-connected.xlsx --tab=final
# Pending-only each run (merges prior *-tracking.xlsx). Default limit=20, concurrency=20. Use --all for all pending.
# Find by url; if missing find by new_url → status "Already Updated" (no write). Else update url/canonical/url_list + append cats/topics.
# Seeds UIDs from extract/migrate tracking when possible.
# CLI: npm run pipeline:update-bconnected-stories -- --env=stack-a --workbook=b-connected.xlsx --tab=final

# --- Web redirects (migrate-web-redirects) ---
# Excel: web-redirects.xlsx (default tab "web-redirects")
# Columns: title → title, url → redirect_condition, new_url → redirect_mapping
# Pending/Fail only each run; Pass skipped unless --update. Default limit=25.
# WEB_REDIRECT_WORKBOOK=web-redirects.xlsx
# WEB_REDIRECT_TAB=web-redirects
# CS_CONTENT_TYPE_WEB_REDIRECTS=webredirects
# WEB_REDIRECT_FIELD_CONDITION=redirect_condition
# WEB_REDIRECT_FIELD_MAPPING=redirect_mapping
# WEB_REDIRECT_FIELD_STATUS=status
# WEB_REDIRECT_STATUS_VALUE=301
# WEB_REDIRECT_LIMIT=25
# WEB_REDIRECT_CONCURRENCY=4
# CLI: npm run pipeline:migrate-web-redirects -- --env=stack-a --workbook=web-redirects.xlsx --tab=web-redirects
# CLI: npm run pipeline:migrate-web-redirects -- --env=stack-a --workbook=web-redirects.xlsx --update
# Writes: web-redirects-tracking.xlsx (title, url, new_url, contentstack_entry_uid, Pass/Fail)

# Banner image group (legacy; use thumbnail below for featured_media):
# WP featured_media → banner_image group → file
# BLOG_FIELD_BANNER_IMAGE=banner_image
# BLOG_BANNER_IMAGE_LAYOUT=group
# BLOG_BANNER_IMAGE_FILE_FIELD=file
# BLOG_FEATURED_IMAGE_TARGET=thumbnail
# Article image global (default for featured_media): article_image → image_preset → image (Image Preset Picker)
# BLOG_FIELD_ARTICLE_IMAGE=article_image
# BLOG_FIELD_THUMBNAIL=article_image
# BLOG_THUMBNAIL_IMAGE_PRESET_FIELD=image
# BLOG_THUMBNAIL_PRESET_IMAGE_FIELD=image
# Set when CMA requires Image Preset Builder metadata (see Image Preset Builder app docs):
# BLOG_THUMBNAIL_PRESET_EXTENSION_UID=blt933ba0bafb614a79
# BLOG_THUMBNAIL_PRESET_UID=f644f13f-2d4b-4809-8a02-92707e34b668
# BLOG_THUMBNAIL_PRESET_NAME=Test_Preset
# Uses BLOG_AUTHOR_FILE_REF_SHAPE for nested file UID shape (default uid string).
# BLOG_FIELD_BANNER_VIDEO=banner_video
# BLOG_FIELD_BYLINE=byline
# BLOG_FIELD_BLOG_AUTHOR_PROFILE=blog_author_profile
# SEO & Social group (same pattern as blog_category):
# BLOG_FIELD_SEO_SOCIAL_GROUP=seo
# BLOG_FIELD_SEO_TITLE=title
# page_url: default canonical_url_list → { canonical, url_list[{ url, status, redirect }] }
# BLOG_SEO_PAGE_URL_SHAPE=canonical_url_list
# BLOG_FIELD_META_DESCRIPTION=meta_description
# BLOG_FIELD_META_IMAGE=meta_image
# BLOG_SEO_META_IMAGE_FILE_FIELD=file
# meta_description in seo group: wp_seo (default) or name (headline)
# BLOG_META_DESCRIPTION_SOURCE=wp_seo
# BLOG_WP_TAXONOMY_CATEGORY=story_category
# BLOG_WP_TAXONOMY_AUTHOR=story_author
# BLOG_REF_CONTENT_TYPE_CATEGORY=blog_category
# BLOG_REF_CONTENT_TYPE_AUTHOR=blog_author
# BLOG_REFERENCE_SHAPE=array
# BLOG_META_SUB_HEADER=subhead
# Body Content global field on blog (references global `modular_body`):
# CMA: modular_body: { modular_blocks: [{ text: { group_title, subhead, text } }, ...] }
# BLOG_FIELD_MODULAR_BODY=modular_body
# BLOG_FIELD_MODULAR_BLOCKS=modular_blocks
# Legacy alias: BLOG_FIELD_BODY_CONTENT=modular_body
# BLOG_BODY_SOURCE=blocks_then_rendered
# BLOG_BODY_HEADING_GROUP_MAX_LEVEL=2  # unused: core/heading always maps to subhead
# Log content + content.blocks during migrate (default on; set 0 to disable).
# BLOG_BODY_LOG_CONTENT=1
# BLOG_BODY_LOG_MAX_BYTES=8000
# Text block: group_title, subhead, text (Rich Text / HTML)
# BLOG_BODY_BLOCK_TEXT=text
# BLOG_BODY_TEXT_GROUP_TITLE=group_title
# BLOG_BODY_TEXT_SUBHEAD=subhead
# BLOG_BODY_TEXT_BODY=text
# Image block: file only
# BLOG_BODY_BLOCK_IMAGE=image
# BLOG_BODY_IMAGE_FILE=file
# core/image attributes.caption → image.title_tooltip (plain text)
# BLOG_BODY_IMAGE_TITLE_TOOLTIP=title_tooltip
# Testimonial modular block (core/pullquote → quote + author):
# BLOG_BODY_BLOCK_TESTIMONIAL=testimonial
# BLOG_BODY_TESTIMONIAL_QUOTE=quote
# BLOG_BODY_TESTIMONIAL_AUTHOR=author
# Video/Audio block: `core/embed` → create/find `video` entry → reference on `video_audio.video`
# YouTube: type=YouTube, youtube_url + url (embed URL). Brightcove: type + brightcove_media_id.
# BLOG_BODY_BLOCK_VIDEO_AUDIO=video
# BLOG_BODY_VIDEO_FIELD=video
# BLOG_BODY_VIDEO_REF_CONTENT_TYPE=video
# BLOG_BODY_VIDEO_REFERENCE_SHAPE=array
# VIDEO_FIELD_TYPE=type
# VIDEO_FIELD_YOUTUBE_URL=youtube_url
# VIDEO_FIELD_BRIGHTCOVE_MEDIA_ID=brightcove_media_id
# VIDEO_FIELD_URL=url
# VIDEO_TYPE_YOUTUBE=YouTube
# VIDEO_TYPE_BRIGHTCOVE=Brightcove
# VIDEO_TYPE_BRIGHTCOVE_AUDIO=Brightcove Audio
# Uses BLOG_AUTHOR_FILE_REF_SHAPE for image file refs in body blocks.
# Optional select defaults when WP has no value:
# BLOG_DEFAULT_SHOW_IN_NEWSROOM_LANDING=
# BLOG_DEFAULT_SHOW_IN_LATEST_BLOGS=
# Migrate categories and authors first so references resolve.
# BLOG_UPDATE=1
# CLI: npm run pipeline:extract -- --env=stack-a --tab=stories
# CLI: npm run pipeline:migrate-blog-stories -- --env=stack-a --mode=single --single-id=123

# --- Press Release migration (migrate-press-releases) ---
# Same WordPress story JSON → Contentstack content type `press_release` (separate from blog).
# No article_image. Body = HTML RTE from WP blocks (hero/images skipped).
# CS_CONTENT_TYPE_PRESS_RELEASE=press_release
# PRESS_RELEASE_START_SHEET=stories
# PRESS_RELEASE_URL_TEMPLATE=/company/news/releases/{slug}
# PRESS_RELEASE_DEFAULT_LOCATION=SAN JOSE, Calif. United States
# PRESS_RELEASE_DEFAULT_STATUS=Active
# Sheet columns (optional): new_url, L1, L2, Series → article_category (blog_category), Location
# CLI: npm run pipeline:extract -- --env=stack-a --tab=stories
# CLI: npm run pipeline:migrate-press-releases -- --env=stack-a --mode=single --single-id=42788
# CLI: npm run pipeline:migrate-press-releases -- --env=stack-a --mode=ids --ids=42788 --update

# --- Local folder image upload (upload-folder-images) ---
# Upload images from a local folder tree into Contentstack assets (mirrors subfolders).
# Requires CS_ASSET_FOLDER_UID (parent asset folder in Contentstack).
# FOLDER_IMAGES_LOCAL_PATH=D:/photos/emea
# FOLDER_IMAGES_TRACKING_WORKBOOK=folder-image-uploads.xlsx
# FOLDER_IMAGES_CONCURRENCY=4
# CLI: npm run pipeline:upload-folder-images -- --env=stack-a --folder=D:/photos/emea

# --- Entry URL / SEO canonical update (update-entry-urls) ---
# Excel in the same folder as MIGRATION_SOURCE_WORKBOOK (or absolute path).
# Required columns: uid, updated_url
# Optional columns: content_type_uid, locale, url, seo.page_url.canonical
# Updates entry `url` and `seo.page_url.canonical` (preserves other seo fields).
# UPDATE_ENTRY_URL_WORKBOOK=entry-url-updates.xlsx
# UPDATE_ENTRY_URL_CONTENT_TYPE=blog
# UPDATE_ENTRY_URL_LOCALE=en-us
# UPDATE_ENTRY_URL_CONCURRENCY=4
# UPDATE_ENTRY_URL_FIELD=url
# UPDATE_ENTRY_URL_SEO_GROUP=seo
# UPDATE_ENTRY_URL_SEO_PAGE_URL=page_url
# UPDATE_ENTRY_URL_CANONICAL_FIELD=canonical
# CLI: npm run pipeline:update-entry-urls -- --env=stack-a --workbook=entry-url-updates.xlsx --content-type=blog
# CLI single: npm run pipeline:update-entry-urls -- --env=stack-a --mode=single --uid=bltxxx --content-type=blog
# CLI ids: npm run pipeline:update-entry-urls -- --env=stack-a --mode=ids --uids=uid1,uid2 --content-type=blog
